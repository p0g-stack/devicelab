LOCAL_PATH := device/p0g/aera_cf
PRODUCT_SHIPPING_API_LEVEL := 34
PRODUCT_SOONG_NAMESPACES += $(LOCAL_PATH)

AERA_MAINTAINER := p0g-stack devicelab
AERA_OPTIONS_LIST_NUM := 6
AERA_USE_GREEN_LED := 0
AERA_NO_TREBLE_COMPATIBILITY_CHECK := 1
AERA_SKIP_LEGACY_PATCH_PROCESS := 1

# TARGET_NO_KERNEL would otherwise turn off BUILDING_RECOVERY_IMAGE (and then
# BOARD_EXCLUDE_KERNEL_FROM_RECOVERY_IMAGE is rejected by board_config.mk).
PRODUCT_BUILD_RECOVERY_IMAGE := true
