From ea6d1ceff32361e0481cf0b79aba83ea43a61c98 Mon Sep 17 00:00:00 2001
From: aera-lab <aera-lab@localhost>
Date: Thu, 1 Oct 2026 07:49:33 +0000
Subject: [PATCH] aeraui: build libwebp SSE2/SSE4.1 dsp sources on x86

libaera_webp_decoder only listed the NEON sources, so x86_64 recovery links
failed on VP8DspInitSSE2, WebPInitSamplersSSE41 and friends, which cpu.c's
runtime dispatch references whenever WEBP_HAVE_SSE2/SSE41 are set.
---
 aeraui/third_party/libwebp/Android.bp | 34 +++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/aeraui/third_party/libwebp/Android.bp b/aeraui/third_party/libwebp/Android.bp
index ff19884..9b0513d 100644
--- a/aeraui/third_party/libwebp/Android.bp
+++ b/aeraui/third_party/libwebp/Android.bp
@@ -51,6 +51,40 @@ cc_library_static {
         "src/utils/thread_utils.c",
         "src/utils/utils.c",
     ],
+    arch: {
+        // x86 builds pick the SSE paths at runtime (cpu.c); without these the
+        // dsp init functions reference undefined *SSE2/*SSE41 symbols.
+        x86: {
+            srcs: [
+                "src/dsp/alpha_processing_sse2.c",
+                "src/dsp/alpha_processing_sse41.c",
+                "src/dsp/dec_sse2.c",
+                "src/dsp/dec_sse41.c",
+                "src/dsp/filters_sse2.c",
+                "src/dsp/lossless_sse2.c",
+                "src/dsp/lossless_sse41.c",
+                "src/dsp/upsampling_sse2.c",
+                "src/dsp/upsampling_sse41.c",
+                "src/dsp/yuv_sse2.c",
+                "src/dsp/yuv_sse41.c",
+            ],
+        },
+        x86_64: {
+            srcs: [
+                "src/dsp/alpha_processing_sse2.c",
+                "src/dsp/alpha_processing_sse41.c",
+                "src/dsp/dec_sse2.c",
+                "src/dsp/dec_sse41.c",
+                "src/dsp/filters_sse2.c",
+                "src/dsp/lossless_sse2.c",
+                "src/dsp/lossless_sse41.c",
+                "src/dsp/upsampling_sse2.c",
+                "src/dsp/upsampling_sse41.c",
+                "src/dsp/yuv_sse2.c",
+                "src/dsp/yuv_sse41.c",
+            ],
+        },
+    },
     export_include_dirs: ["src"],
     cflags: [
         "-DANDROID",
-- 
2.43.0

